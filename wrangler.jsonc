{
  // Cloudflare Worker config for the SHD Field Toolkit.
  // "name" MUST match the Worker in the dashboard, or a deploy creates a new one.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "green-feather-79f5",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // The website/ folder is served as static files. Only /api/* runs code.
  "assets": {
    "directory": "./website",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // The database. Create it in the dashboard (Storage & Databases → D1 →
  // Create database, name "shd-toolkit") and paste its Database ID below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shd-toolkit",
      "database_id": "8f15a4cd-7133-4d43-b039-297a92358a4f"
    }
  ],

  // Keep the variables set in the dashboard (Settings → Variables and Secrets:
  // ACCESS_TEAM_DOMAIN and ACCESS_AUD).
  // Without this, every deploy would wipe the plain-text ones.
  "keep_vars": true,

  "observability": { "enabled": true }
}
